{
  "name": "game-core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/game-core.iife.js",
  "module": "./dist/game-core.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/game-core.es.js",
      "default": "./dist/game-core.iife.js"
    },
    "./pixi": {
      "types": "./dist/pixi/pixi/index.d.ts",
      "import": "./dist/pixi/game-core-pixi.es.js"
    },
    "./platform/yandex": {
      "types": "./dist/platform/yandex/platform/adapters/yandex/index.d.ts",
      "import": "./dist/platform/yandex/game-core-platform-yandex.es.js"
    },
    "./platform/cleverapps": {
      "types": "./dist/platform/cleverapps/platform/adapters/cleverapps/index.d.ts",
      "import": "./dist/platform/cleverapps/game-core-platform-cleverapps.es.js"
    },
    "./qa": {
      "types": "./dist/qa/qa/index.d.ts",
      "import": "./dist/qa/game-core-qa.es.js"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "npm run build:core && npm run build:pixi && npm run build:platform-yandex && npm run build:platform-cleverapps && npm run build:qa && node scripts/check-pixi-build.mjs && node scripts/check-platform-build.mjs && node scripts/check-qa-build.mjs",
    "build:core": "vite build",
    "build:pixi": "vite build --config vite.pixi.config.ts",
    "build:platform-yandex": "vite build --config vite.platform-yandex.config.ts",
    "build:platform-cleverapps": "vite build --config vite.platform-cleverapps.config.ts",
    "build:qa": "vite build --config vite.qa.config.ts",
    "showcase": "vite --config vite.showcase.config.ts",
    "showcase:build": "vite build --config vite.showcase.config.ts",
    "showcase:shots": "node scripts/showcase-screenshots.mjs",
    "showcase:offers": "node scripts/offer-demo-check.mjs",
    "showcase:analytics": "node scripts/analytics-demo-check.mjs",
    "showcase:purchase": "node scripts/purchase-demo-check.mjs",
    "showcase:ads": "node scripts/ads-demo-check.mjs",
    "showcase:overlay": "node scripts/overlay-demo-check.mjs",
    "showcase:orientation": "node scripts/orientation-guard-check.mjs",
    "showcase:confirm": "node scripts/confirm-exit-check.mjs",
    "showcase:lives": "node scripts/lives-check.mjs",
    "showcase:localization": "node scripts/localization-check.mjs",
    "showcase:qa": "node scripts/qa-panel-check.mjs",
    "showcase:confetti": "node scripts/confetti-check.mjs",
    "showcase:style2": "node scripts/style2-level-map-check.mjs",
    "qa:isolation": "node scripts/qa-isolation-check.mjs",
    "smoke:platform": "node scripts/platform-dev-smoke.mjs",
    "smoke:platform-yandex": "node scripts/platform-yandex-smoke.mjs",
    "smoke:platform-cleverapps": "node scripts/platform-cleverapps-smoke.mjs",
    "figma:assets": "node scripts/figma-assets.mjs",
    "sync:word-tide": "node scripts/sync-word-tide.mjs",
    "ocean:compare": "node scripts/ocean-compare.mjs"
  },
  "peerDependencies": {
    "pixi.js": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "pixi.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "pixi.js": "8.14.3",
    "playwright": "1.61.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vite-plugin-dts": "^4.2.4",
    "vitest": "^2.1.2"
  }
}
