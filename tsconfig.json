{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "game-core": ["./src/index.ts"],
      "game-core/pixi": ["./src/pixi/index.ts"],
      "game-core/platform/yandex": ["./src/platform/adapters/yandex/index.ts"]
    }
  },
  "include": [
    "src",
    "tests",
    "examples",
    "vite.config.ts",
    "vite.pixi.config.ts",
    "vite.platform-yandex.config.ts",
    "vite.showcase.config.ts"
  ]
}
